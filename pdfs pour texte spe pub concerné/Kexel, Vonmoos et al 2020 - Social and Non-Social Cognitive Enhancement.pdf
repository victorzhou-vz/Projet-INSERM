      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Social and Non-Social Cognitive Enhancement in Cocaine Users&amp;mdash;A Closer Look on Enhancement Motives for Cocaine Consumption</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Ann-Kathrin Kexel; Matthias Vonmoos; Katrin H. Preller; Lea M. Hulka; Erich Seifritz; Boris B. Quednow</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Background: Cognitive disturbances of chronic cocaine users (CU) have been repeatedly investigated</rdf:li>
            </rdf:Alt>
         </dc:description>
      </rdf:Description>
